APP_NAME="IT HELPDESK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Attach a persistent database in Laravel Cloud and use its injected credentials.
DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Attach a PRIVATE object storage bucket as the default disk in Laravel Cloud.
FILESYSTEM_DISK=s3
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_NAME="${APP_NAME}"
